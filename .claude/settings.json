{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m src.:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ],
    "deny": [
      "Write(./data/raw/**)",
      "Edit(./data/raw/**)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_leakage.sh\""
          }
        ]
      }
    ]
  }
}
